---
import { Image } from "astro:assets";
import heroImg from "@/assets/images/events/vol01-group.jpg";
---

<section id="hero" class="relative h-screen h-[100svh] overflow-hidden">
  <!-- Background image, optimized by Astro -->
  <div class="absolute inset-0">
    <Image
      src={heroImg}
      alt="Palm & Plate community at a dining event"
      width={1920}
      height={1080}
      quality={70}
      format="webp"
      class="w-full h-full object-cover object-top parallax"
      data-speed="0.15"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/60 to-charcoal/20"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/40 to-transparent"></div>
  </div>

  <!-- Content (vertically centered, with reserved top room for nav and bottom room for arrow) -->
  <div class="relative z-10 w-full h-full flex items-center px-6 md:px-12 pt-28 md:pt-32 pb-24 md:pb-28" style="padding-top: calc(7rem + env(safe-area-inset-top)); padding-bottom: calc(6rem + env(safe-area-inset-bottom));">
    <div class="w-full max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <div class="hero-fade inline-flex items-center gap-3 mb-5">
          <div class="w-8 h-[1px] bg-saffron"></div>
          <p class="text-saffron font-body font-medium tracking-[0.3em] uppercase text-xs">
            Bahrain's First Food Club
          </p>
        </div>

        <h1
          class="hero-fade hero-delay-1 font-heading text-cream mb-5 uppercase max-w-full"
          style="font-size: clamp(1.75rem, 3.6vw, 3.5rem); line-height: 1.25; letter-spacing: -0.01em;"
        >
          WHERE EVERY MEAL<br />
          TELLS A <span class="text-saffron">STORY</span>
        </h1>

        <p class="hero-fade hero-delay-2 text-sm sm:text-base md:text-lg text-cream/70 font-body font-light max-w-xl mb-7 leading-relaxed">
          Curated dining experiences that bring together Bahrain's most passionate food lovers.
          One table, one night, one unforgettable memory.
        </p>

        <div class="hero-fade hero-delay-3 flex flex-col sm:flex-row gap-3 sm:gap-4">
          <a href="#waitlist" class="btn-primary">Join the Waitlist</a>
          <a href="#about" class="btn-secondary">Discover More</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Single scroll-down arrow, anchored to the bottom of the hero on every viewport -->
  <a
    href="#about"
    class="hero-fade hero-delay-3 absolute left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 group"
    style="bottom: calc(1.25rem + env(safe-area-inset-bottom));"
    aria-label="Scroll down to About"
  >
    <span class="w-10 h-10 rounded-full border border-cream/30 flex items-center justify-center group-hover:border-saffron/60 transition-colors duration-300 backdrop-blur-sm bg-charcoal/30">
      <svg class="w-4 h-4 text-cream/60 group-hover:text-saffron transition-colors duration-300 scroll-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </span>
  </a>
</section>

<!-- Marquee strip -->
<div class="bg-clay py-3 overflow-hidden">
  <div class="animate-marquee whitespace-nowrap flex">
    {Array(6).fill(null).map(() => (
      <span class="mx-8 text-cream/80 font-body text-sm tracking-widest uppercase flex items-center gap-8">
        <span>One Table</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Shared Stories</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Real Connections</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Invite Only</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Pop Up Dinners</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Tasting Menus</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
        <span>Communal Dining</span>
        <svg class="w-4 h-4 text-saffron shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8c0-2.76-2.46-5-5.5-5S2 5.24 2 8h2l1-1 1 1h4"/><path d="M13 7.14A5.82 5.82 0 0 1 16.5 6c3.04 0 5.5 2.24 5.5 5h-3l-1-1-1 1h-3"/><path d="M5.89 9.71c-2.15 2.15-2.3 5.47-.35 7.43l4.24-4.25.7-.7.71-.71 2.12-2.12c-1.95-1.96-5.27-1.8-7.42.35z"/><path d="M11 15.5c.5 2.5-.17 4.5-1 6.5h4c2-5.5-.5-12-1-14"/></svg>
      </span>
    ))}
  </div>
</div>

<style>
  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-fade { animation: hero-enter 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-delay-1 { animation-delay: 0.2s; }
  .hero-delay-2 { animation-delay: 0.4s; }
  .hero-delay-3 { animation-delay: 0.6s; }
  @keyframes scroll-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  .scroll-arrow { animation: scroll-bounce 2s ease-in-out infinite; }
</style>
