---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";

// Hero / opening images
import heroImg from "@/assets/images/events/vol01/vol01-01.jpg";
import storyImg1 from "@/assets/images/events/vol02/vol02-06.jpg";
import storyImg2 from "@/assets/images/events/vol04/vol04-04.jpg";
import storyImg3 from "@/assets/images/events/vol05/vol05-04.jpg";

// Timeline images, one per volume
import vol01Cover from "@/assets/images/events/vol01/vol01-07.jpg";
import vol02Cover from "@/assets/images/events/vol02/vol02-03.jpg";
import vol03Cover from "@/assets/images/events/vol03/vol03-04.jpg";
import vol04Cover from "@/assets/images/events/vol04/vol04-05.jpg";
import vol05Cover from "@/assets/images/events/vol05/vol05-07.jpg";
import vol06Cover from "@/assets/images/events/vol06/vol06-04.jpg";
import vol07Cover from "@/assets/images/events/vol07/vol07-06.jpg";
import vol08Cover from "@/assets/images/events/vol08/vol08-07.jpg";
import vol09Cover from "@/assets/images/events/vol09/vol09-03.jpg";

// Closing
import closingImg from "@/assets/images/events/vol01/vol01-01.jpg";
import logoIcon from "@/assets/images/brand/logo-icon-gold.png";

const milestones = [
  { vol: "01", name: "Loy Krathong", venue: "Monsoon", date: "Nov 2025", seats: 12, desc: "Where it all began. 12 strangers, 11 courses, one long table at Bahrain's most iconic Asian restaurant. Nobody knew what to expect, and that was the magic.", img: vol01Cover },
  { vol: "02", name: "Italian Night", venue: "Osteria Papa", date: "Nov 2025", seats: 14, desc: "Two weeks later, we were back. An outdoor terrace, handmade pizza, string lights, and the Bahrain skyline. Word was spreading.", img: vol02Cover },
  { vol: "03", name: "Opening Night", venue: "Nori Club by Sumosan", date: "Dec 2025", seats: 16, desc: "Japanese fine dining with members who were now becoming friends. The waitlist started growing.", img: vol03Cover },
  { vol: "04", name: "Layali Muharraq", venue: "LaBurccia", date: "Dec 2025", seats: 18, desc: "A night in old Muharraq: lanterns, traditional dishes, and conversations that lasted long after dessert.", img: vol04Cover },
  { vol: "05", name: "Holiday Feast", venue: "Diana's", date: "Dec 2025", seats: 20, desc: "Our biggest night yet. Santa hats, chocolate lava cake, and 20 seats around a Christmas table. We were a community now.", img: vol05Cover },
  { vol: "06", name: "Crazy Pizza", venue: "Crazy Pizza", date: "Jan 2026", seats: 18, desc: "Italian flair meets Bahrain energy. The vibe was electric. This was the night that proved the concept was bigger than dinners.", img: vol06Cover },
  { vol: "07", name: "BBQ on the Terrace", venue: "Higher Grounds", date: "Jan 2026", seats: 15, desc: "Rooftop grills, good vibes, and a view of the city. Proof that Palm & Plate works anywhere, not just fine dining.", img: vol07Cover },
  { vol: "08", name: "Valentines Preview", venue: "Ramenara", date: "Feb 2026", seats: 20, desc: "Love was in the air, and in the ramen. A Valentine's preview night that showed our softer side.", img: vol08Cover },
  { vol: "09", name: "Fatto", venue: "Fatto", date: "Mar 2026", seats: 20, desc: "Italian craftsmanship at its finest. Season 1 nearing its close, but the journey was just beginning.", img: vol09Cover },
];
---

<Layout title="Our Story, Palm & Plate" description="The story behind Bahrain's first food club, from a simple idea to a movement around the table.">
  <Navbar />

  <main class="bg-charcoal">

    <!-- ═══════ CHAPTER 1: THE OPENING ═══════ -->
    <section class="relative min-h-screen flex items-end overflow-hidden">
      <!-- Full-bleed hero image -->
      <div class="absolute inset-0">
        <Image
          src={heroImg}
          alt="Palm & Plate members gathered around the table"
          width={1920}
          height={1080}
          quality={75}
          format="webp"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/70 to-charcoal/20"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-charcoal/50 to-transparent"></div>
      </div>

      <!-- Opening text -->
      <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 pb-20 md:pb-32 pt-40">
        <div class="max-w-3xl">
          <div class="hero-fade flex items-center gap-3 mb-8">
            <div class="w-12 h-[1px] bg-saffron"></div>
            <p class="text-saffron font-body font-medium tracking-[0.4em] uppercase text-xs">Our Story</p>
          </div>

          <h1 class="hero-fade hero-delay-1 font-heading text-cream leading-[1.35]" style="font-size: clamp(2.5rem, 7vw, 5.5rem);">
            IT STARTED WITH<br />
            <span class="text-saffron">ONE TABLE</span>
          </h1>

          <div class="hero-fade hero-delay-2 w-16 h-[2px] bg-saffron mt-10 mb-10"></div>

          <p class="hero-fade hero-delay-3 text-cream/60 font-body font-light text-lg md:text-xl leading-[1.8] max-w-xl">
            A belief that the best meals aren't about what's on the plate, but who's around the table.
          </p>
        </div>

        <!-- Scroll indicator -->
        <div class="hero-fade hero-delay-3 absolute bottom-8 left-1/2 -translate-x-1/2">
          <div class="w-[1px] h-16 bg-gradient-to-b from-transparent to-saffron/40 animate-pulse"></div>
        </div>
      </div>
    </section>

    <!-- ═══════ CHAPTER 2: THE BELIEF ═══════ -->
    <section class="py-24 md:py-40 relative overflow-hidden">
      <!-- Subtle background glow -->
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-saffron/[0.02] rounded-full blur-3xl pointer-events-none"></div>

      <div class="max-w-4xl mx-auto px-6 md:px-12">
        <div class="reveal text-center mb-20">
          <p class="text-saffron font-body font-medium tracking-[0.4em] uppercase text-xs mb-8">Chapter One</p>
          <h2 class="font-heading text-cream text-2xl sm:text-3xl md:text-5xl leading-[1.4] md:leading-[1.35] mb-8">
            FOR ARABS, PALMS ARE A SYMBOL OF<br />
            <span class="text-clay">HOME</span>, <span class="text-clay">GROWTH</span> &
            <span class="text-saffron">HOSPITALITY</span>
          </h2>
          <div class="w-16 h-[2px] bg-saffron mx-auto"></div>
        </div>

        <!-- The story text, editorial layout -->
        <div class="reveal space-y-8 mb-20">
          <p class="text-cream/70 font-body font-light text-lg md:text-xl leading-[1.9] first-letter:text-6xl first-letter:font-heading first-letter:text-saffron first-letter:float-left first-letter:mr-3 first-letter:mt-1">
            Palm & Plate was born in Bahrain in 2025 from a simple observation: the island had
            incredible restaurants, passionate food lovers, and a deep culture of hospitality, but
            no way to bring them all together around one table.
          </p>
          <p class="text-cream/60 font-body font-light text-lg leading-[1.9]">
            We started with an idea. What if we could create intimate dining experiences that weren't
            just about the food, but about the people? Not a restaurant. Not a catering service. A community.
            A club where every meal tells a story, every plate connects strangers, and every evening
            ends with new friendships.
          </p>
          <p class="text-cream/60 font-body font-light text-lg leading-[1.9]">
            We called it Palm & Plate. The palm, rooted in Arab identity, a symbol of growth, shade,
            and generosity. The plate, the universal invitation to sit down and share something together.
          </p>
        </div>

        <!-- Pull quote -->
        <div class="reveal relative py-12 my-16">
          <div class="absolute left-0 top-0 bottom-0 w-[3px] bg-gradient-to-b from-saffron via-clay to-saffron/20"></div>
          <blockquote class="pl-8 md:pl-12">
            <p class="font-heading text-2xl md:text-4xl text-cream leading-[1.4] italic">
              "The best meals aren't just about what's on the plate. They're about who's around the table."
            </p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ═══════ FEATURED ON BAHRAIN TV ═══════ -->
    <section class="py-24 md:py-40 relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-[1px] bg-cream/5"></div>

      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <div class="reveal text-center mb-16">
          <p class="text-saffron font-body font-medium tracking-[0.4em] uppercase text-xs mb-8">As Seen On</p>
          <h2 class="font-heading text-cream text-2xl sm:text-3xl md:text-5xl leading-[1.4] md:leading-[1.35] mb-6">
            FEATURED ON<br />
            <span class="text-saffron">BAHRAIN TV</span>
          </h2>
          <p class="text-cream/40 font-body font-light text-lg max-w-xl mx-auto">
            When Bahrain TV came to tell our story, we knew Palm & Plate had become something bigger
            than dinners. It was a movement.
          </p>
        </div>

        <div class="reveal relative rounded-2xl overflow-hidden shadow-2xl shadow-saffron/5">
          <div class="absolute -inset-[1px] bg-gradient-to-br from-saffron/20 via-transparent to-clay/20 rounded-2xl"></div>
          <div class="relative bg-charcoal rounded-2xl overflow-hidden">
            <div class="aspect-video">
              <iframe
                src="https://www.youtube.com/embed/SCfWHPCyBbc"
                title="Palm & Plate, Featured on Bahrain TV"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
                class="w-full h-full"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ PHOTO BREAK: THREE IMAGES ═══════ -->
    <section class="reveal">
      <div class="grid grid-cols-3 gap-[2px] h-[250px] md:h-[400px]">
        <div class="overflow-hidden">
          <Image src={storyImg1} alt="Long table dinner" width={640} height={400} quality={70} format="webp" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
        <div class="overflow-hidden">
          <Image src={storyImg2} alt="Members at LaBurccia" width={640} height={400} quality={70} format="webp" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
        <div class="overflow-hidden">
          <Image src={storyImg3} alt="Holiday feast at Diana's" width={640} height={400} quality={70} format="webp" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- ═══════ CHAPTER 3: THE JOURNEY, TIMELINE ═══════ -->
    <section class="py-24 md:py-40 relative">
      <div class="max-w-7xl mx-auto px-6 md:px-12">
        <div class="reveal text-center mb-20 md:mb-28">
          <p class="text-saffron font-body font-medium tracking-[0.4em] uppercase text-xs mb-8">Chapter Two</p>
          <h2 class="font-heading text-cream text-2xl sm:text-3xl md:text-5xl leading-[1.4] md:leading-[1.35] mb-6">
            CHAPTER ONE<br />
            <span class="text-saffron">9 VOLUMES. 9 STORIES.</span>
          </h2>
          <p class="text-cream/40 font-body font-light text-lg max-w-xl mx-auto">
            Each volume is a new chapter. A different restaurant, a different menu, a different night to remember.
          </p>
        </div>

        <!-- Timeline -->
        <div class="relative">
          <!-- Center line (desktop only) -->
          <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-[1px] bg-cream/10 -translate-x-1/2"></div>

          {milestones.map((m, idx) => {
            const isLeft = idx % 2 === 0;
            return (
              <div class="reveal relative md:grid md:grid-cols-2 md:gap-16 mb-16 md:mb-24 last:mb-0">
                {/* Timeline dot */}
                <div class="hidden md:flex absolute left-1/2 top-8 -translate-x-1/2 z-10 w-12 h-12 rounded-full bg-charcoal border-2 border-saffron/40 items-center justify-center">
                  <span class="text-saffron font-body font-bold text-[10px] tracking-widest">{m.vol}</span>
                </div>

                {/* Image side */}
                <div class:list={["relative rounded-xl overflow-hidden aspect-[4/3] mb-6 md:mb-0", isLeft ? "md:order-1" : "md:order-2"]}>
                  <Image
                    src={m.img}
                    alt={`${m.name} at ${m.venue}`}
                    width={600}
                    height={450}
                    quality={70}
                    format="webp"
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-charcoal/60 to-transparent"></div>
                  <div class="absolute bottom-4 left-4">
                    <span class="bg-saffron text-charcoal font-body font-bold text-[10px] tracking-widest uppercase px-3 py-1 rounded-full">
                      Vol. {m.vol}
                    </span>
                  </div>
                </div>

                {/* Text side */}
                <div class:list={["flex flex-col justify-center", isLeft ? "md:order-2 md:pl-8" : "md:order-1 md:pr-8 md:text-right"]}>
                  {/* Mobile vol badge */}
                  <div class="md:hidden flex items-center gap-2 mb-3">
                    <span class="bg-saffron/10 text-saffron font-body font-bold text-[10px] tracking-widest uppercase px-3 py-1 rounded-full">
                      Vol. {m.vol}
                    </span>
                    <span class="text-cream/30 font-body text-xs">{m.date}</span>
                  </div>

                  <span class="hidden md:block text-cream/30 font-body text-sm tracking-wider mb-3">{m.date}</span>
                  <p class="text-cream/50 font-body text-sm tracking-wider uppercase mb-1">{m.name}, {m.seats} seats</p>
                  <h3 class="font-heading text-2xl md:text-3xl text-cream mb-4 uppercase">{m.venue}</h3>
                  <p class="text-cream/50 font-body font-light leading-relaxed">{m.desc}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ═══════ THE NUMBERS ═══════ -->
    <section class="py-24 md:py-32 relative">
      <div class="max-w-5xl mx-auto px-6 md:px-12">
        <div class="reveal">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 text-center">
            <div>
              <p class="font-heading text-5xl md:text-6xl text-saffron mb-2">9</p>
              <p class="text-cream/40 font-body text-sm tracking-wider uppercase">Volumes</p>
            </div>
            <div>
              <p class="font-heading text-5xl md:text-6xl text-saffron mb-2">9</p>
              <p class="text-cream/40 font-body text-sm tracking-wider uppercase">Restaurants</p>
            </div>
            <div>
              <p class="font-heading text-5xl md:text-6xl text-saffron mb-2">150+</p>
              <p class="text-cream/40 font-body text-sm tracking-wider uppercase">Seats Filled</p>
            </div>
            <div>
              <p class="font-heading text-5xl md:text-6xl text-saffron mb-2">1</p>
              <p class="text-cream/40 font-body text-sm tracking-wider uppercase">Community</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════ CLOSING: THE INVITATION ═══════ -->
    <section class="relative min-h-[70vh] flex items-center overflow-hidden">
      <div class="absolute inset-0">
        <Image
          src={closingImg}
          alt="Table setting at Monsoon"
          width={1920}
          height={1080}
          quality={70}
          format="webp"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-charcoal/80"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-transparent to-charcoal/60"></div>
      </div>

      <div class="relative z-10 max-w-3xl mx-auto px-6 md:px-12 py-24 md:py-32 text-center">
        <div class="reveal">
          <Image
            src={logoIcon}
            alt=""
            width={80}
            height={80}
            class="mx-auto mb-8 opacity-40"
            loading="lazy"
          />
          <h2 class="font-heading text-cream text-2xl sm:text-3xl md:text-5xl leading-[1.4] md:leading-[1.35] mb-6">
            THE TABLE IS SET.<br />
            <span class="text-saffron">YOUR SEAT AWAITS.</span>
          </h2>
          <p class="text-cream/50 font-body font-light text-lg leading-relaxed max-w-lg mx-auto mb-10">
            Palm & Plate is more than a food club. It's a community of people who believe that breaking
            bread together is one of life's most beautiful acts. Chapter 2 is coming.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="/#waitlist" class="btn-primary">
              Join the Waitlist
            </a>
            <a href="/volumes" class="btn-secondary">
              Explore Volumes
            </a>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* Hero entry animations */
  @keyframes hero-enter {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .hero-fade { animation: hero-enter 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
  .hero-delay-1 { animation-delay: 0.2s; }
  .hero-delay-2 { animation-delay: 0.4s; }
  .hero-delay-3 { animation-delay: 0.6s; }

  /* Editorial drop cap enhancement */
  .first-letter\:text-6xl::first-letter {
    line-height: 0.8;
  }
</style>
