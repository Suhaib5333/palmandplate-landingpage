name: Deploy Landing Page

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Test VPS connectivity
        run: |
          nc -zv -w 10 ${{ secrets.VPS_HOST }} 22 || echo "Port 22 unreachable"

      - name: Deploy to VPS
        uses: appleboy/ssh-action@v1
        with:
          host: ${{ secrets.VPS_HOST }}
          username: root
          key: ${{ secrets.VPS_SSH_KEY }}
          timeout: 120s
          command_timeout: 10m
          script: |
            set -e

            REPO_DIR="/var/www/palmandplate-landing"
            REPO_URL="https://github.com/Suhaib5333/palmandplate-landingpage.git"

            # Clone or pull
            if [ ! -d "$REPO_DIR" ]; then
              git clone "$REPO_URL" "$REPO_DIR"
            else
              cd "$REPO_DIR"
              git fetch origin main
              git reset --hard origin/main
            fi

            cd "$REPO_DIR"

            # Write production env vars
            cat > .env <<EOF
            PUBLIC_MEMBER_APP_URL=http://${{ secrets.VPS_HOST }}:5173
            PUBLIC_API_URL=http://${{ secrets.VPS_HOST }}:3000
            EOF
            sed -i 's/^[[:space:]]*//' .env

            # Install and build
            npm ci
            npm run build

            # Install serve for proper static file serving
            npm i -g serve 2>/dev/null || true

            # Delete old PM2 process and start fresh
            pm2 delete palmandplate-landing 2>/dev/null || true
            pm2 start "serve dist -l 4321 -n" --name palmandplate-landing

            pm2 save
