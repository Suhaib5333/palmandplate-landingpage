---
import { Image } from "astro:assets";

// Pull ALL photos across every volume folder (no duplicates across sections, the spec says no dupes,
// but shuffle here is fine because shuffled picks are randomised per build and per page load)
const allImageModules = import.meta.glob<{ default: ImageMetadata }>(
  "@/assets/images/events/**/*.jpg",
  { eager: true }
);
const allImages = Object.values(allImageModules).map((m) => m.default);

// Shuffle helper, Fisher-Yates
function shuffle<T>(arr: T[]): T[] {
  const copy = [...arr];
  for (let i = copy.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [copy[i], copy[j]] = [copy[j], copy[i]];
  }
  return copy;
}

// Pick 30 shuffled photos at build time for the server render
const pickCount = Math.min(30, allImages.length);
const picked = shuffle(allImages).slice(0, pickCount);

// Visual spans: applied by position, not by image, so hierarchy is preserved across shuffles.
// Pattern repeats every 11 cells to match the existing Row1-4 layout (hero + tall + 2 singles +
// 4 singles + wide + 2 singles = 11).
const spanPattern = [
  "col-span-2 row-span-2",
  "row-span-2",
  "",
  "",
  "",
  "",
  "",
  "",
  "col-span-2",
  "",
  "",
];

// Build the URL list of ALL candidates so the client script can swap images at load
const allImageUrls = allImages.map((img) => img.src);
---

<section id="gallery" class="py-24 md:py-32 bg-charcoal relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-12">

    <div class="text-center mb-16 reveal">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="brand-divider"></div>
        <p class="text-saffron font-body font-medium tracking-[0.25em] uppercase text-xs">Gallery</p>
        <div class="brand-divider"></div>
      </div>
      <h2 class="section-heading text-cream mb-6 uppercase">
        <span class="text-saffron">MOMENTS</span> WE'VE SHARED
      </h2>
      <p class="section-subheading text-cream/40 max-w-xl mx-auto">
        Real people, real food, real connections. A glimpse into our world.
      </p>
    </div>

    <div id="gallery-grid" class="reveal-scale grid grid-cols-2 md:grid-cols-4 auto-rows-[200px] md:auto-rows-[250px] gap-2 md:gap-3">
      {picked.map((image, i) => (
        <div class={`img-zoom rounded-sm overflow-hidden ${spanPattern[i % spanPattern.length]}`}>
          <Image
            src={image}
            alt="Palm & Plate moment"
            width={800}
            height={600}
            quality={70}
            format="webp"
            class="gallery-img w-full h-full object-cover"
            loading="lazy"
          />
        </div>
      ))}
    </div>

    <!-- ALL VOLUMES button, curved pill linking to /volumes -->
    <div class="text-center mt-12 reveal">
      <a
        href="/volumes"
        class="inline-flex items-center gap-3 rounded-full bg-saffron text-charcoal font-body font-bold tracking-widest uppercase text-xs md:text-sm px-10 py-4 hover:bg-saffron-light transition-all duration-500 group"
      >
        <span>All Volumes</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

    <div class="text-center mt-8 reveal">
      <a
        href="https://www.instagram.com/palmnplate/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 text-saffron hover:text-saffron-light font-body text-sm tracking-wider transition-colors duration-300 group"
      >
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
        </svg>
        <span class="tracking-widest uppercase">Follow @palmnplate</span>
      </a>
    </div>

  </div>
</section>

<!-- Client-side shuffle: swap <img> src attributes with a new random pick from the full pool on load -->
<script define:vars={{ allImageUrls }}>
  if (Array.isArray(allImageUrls) && allImageUrls.length > 0) {
    const imgs = document.querySelectorAll("#gallery-grid .gallery-img");
    const pool = [...allImageUrls];
    // Fisher-Yates
    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }
    imgs.forEach((img, idx) => {
      const next = pool[idx % pool.length];
      if (next && img instanceof HTMLImageElement) {
        // Preserve srcset? Astro's optimised image keeps srcset; overriding src alone still works.
        img.removeAttribute("srcset");
        img.src = next;
      }
    });
  }
</script>
