---
import { Image } from "astro:assets";
import bgImg from "@/assets/images/events/vol05/vol05-table.jpg";

const steps = [
  {
    number: "01",
    title: "JOIN THE WAITLIST",
    description: "Apply to become a member. Tell us about your love for food and what excites you about dining in Bahrain.",
  },
  {
    number: "02",
    title: "GET ACCEPTED",
    description: "Our team reviews applications to keep the community intimate and like-minded. You'll hear from us soon.",
  },
  {
    number: "03",
    title: "CHOOSE AN EVENT",
    description: "Browse upcoming volumes, reserve your seat, and show up hungry. We handle the rest, from venue to menu.",
  },
];
---

<section class="relative py-24 md:py-32 overflow-hidden">
  <!-- Shared background photo for the three steps -->
  <Image
    src={bgImg}
    alt=""
    width={1920}
    height={1080}
    quality={70}
    format="webp"
    class="absolute inset-0 w-full h-full object-cover"
    loading="lazy"
  />
  <!-- Heavy overlay for readability -->
  <div class="absolute inset-0 bg-charcoal/85"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-charcoal/60 via-charcoal/75 to-charcoal"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    <!-- Header -->
    <div class="text-center mb-20 reveal">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="brand-divider"></div>
        <p class="text-saffron font-body font-medium tracking-[0.25em] uppercase text-xs">How It Works</p>
        <div class="brand-divider"></div>
      </div>

      <h2 class="section-heading text-cream uppercase">
        THREE STEPS TO YOUR<br /><span class="text-saffron">SEAT</span> AT THE TABLE
      </h2>
    </div>

    <!-- Steps: numbers and text share the same vertical axis per column -->
    <div class="stagger-children grid md:grid-cols-3 gap-12 md:gap-8 lg:gap-12 relative items-start">
      {steps.map((step) => (
        <div class="step-card group relative text-center flex flex-col items-center">
          <div class="relative z-10 flex flex-col items-center w-full">
            <span class="step-number block text-6xl md:text-7xl font-heading text-saffron/30 leading-none mb-4 transition-colors duration-500">
              {step.number}
            </span>
            <h3 class="font-heading text-xl md:text-2xl text-cream mb-4 uppercase tracking-wide min-h-[2.5rem] md:min-h-[3rem] flex items-center">{step.title}</h3>
            <p class="font-body font-light text-cream/60 leading-relaxed max-w-xs min-h-[5.5rem]">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .step-card:hover .step-number {
    color: #D49416; /* deeper saffron */
  }
</style>
