---
import { Image } from "astro:assets";
import { urls } from "@/config";
import logoCream from "@/assets/images/brand/logo-full-cream.png";
import logoIconGold from "@/assets/images/brand/logo-icon-gold.png";

const navLinks = [
  { label: "About", href: "/#about" },
  { label: "Volumes", href: "/volumes" },
  { label: "Membership", href: "/#pricing" },
  { label: "Gallery", href: "/#gallery" },
  { label: "Contact", href: "/#contact" },
];
---

<!-- Top navbar bar -->
<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500">
  <div class="max-w-7xl mx-auto px-6 md:px-12">
    <div class="flex items-center justify-between h-20 md:h-24">
      <!-- Logo -->
      <a href="/" class="relative z-[60]">
        <Image
          src={logoCream}
          alt="Palm & Plate Food Club"
          width={160}
          height={64}
          class="h-12 md:h-14 w-auto nav-logo transition-all duration-500"
          loading="eager"
        />
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center gap-10">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link text-sm font-body font-medium tracking-widest uppercase text-cream/80 hover:text-saffron transition-colors duration-300"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={urls.login}
          class="inline-flex items-center justify-center py-3 px-6 text-xs bg-saffron text-charcoal font-body font-medium tracking-wider uppercase hover:bg-saffron-light transition-all duration-500"
        >
          Log In
        </a>
        <a href="#waitlist" class="btn-primary !py-3 !px-6 !text-xs">
          Join the Waitlist
        </a>
      </div>

      <!-- Mobile Hamburger -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden relative z-[60] w-11 h-11 flex flex-col items-center justify-center gap-[5px]"
        aria-label="Toggle menu"
      >
        <span class="burger-line block w-[22px] h-[2px] bg-cream rounded-sm transition-all duration-300 origin-center"></span>
        <span class="burger-line block w-[22px] h-[2px] bg-cream rounded-sm transition-all duration-300"></span>
        <span class="burger-line block w-[22px] h-[2px] bg-cream rounded-sm transition-all duration-300 origin-center"></span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Menu Overlay (outside nav, full-screen) -->
<div
  id="mobile-menu"
  class="lg:hidden fixed inset-0 z-[55] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500"
  style="background-color: rgba(27, 27, 27, 0.85); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);"
>
  <!-- Click outside to close (background layer, behind content) -->
  <div id="mobile-menu-backdrop" class="absolute inset-0 z-0"></div>

  <!-- Close button -->
  <button
    id="mobile-menu-close"
    class="absolute top-7 right-6 z-10 w-11 h-11 flex items-center justify-center"
    aria-label="Close menu"
  >
    <svg class="w-7 h-7 text-saffron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Subtle radial glow -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[300px] pointer-events-none z-0"
    style="background: radial-gradient(ellipse at top, rgba(245, 181, 50, 0.04) 0%, transparent 70%);"
  ></div>

  <!-- Menu content (above backdrop) -->
  <div class="relative z-10 flex flex-col items-center">
    <Image src={logoIconGold} alt="" width={80} height={80} class="h-16 w-auto mb-8 opacity-30" />

    <div class="flex flex-col items-center gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="mobile-nav-link text-3xl font-heading text-cream hover:text-saffron transition-colors duration-300 py-3 px-7"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="brand-divider mt-8 mb-8"></div>

    <div class="flex flex-col items-center gap-4">
      <a href="#waitlist" class="mobile-nav-link btn-primary">
        Join the Waitlist
      </a>
      <a
        href={urls.login}
        class="mobile-nav-link inline-flex items-center justify-center px-8 py-4 bg-saffron text-charcoal font-body font-medium tracking-wider uppercase text-sm hover:bg-saffron-light transition-all duration-500"
      >
        Log In
      </a>
    </div>
  </div>
</div>

<script>
  const navbar = document.getElementById("navbar");
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const mobileClose = document.getElementById("mobile-menu-close");
  const mobileBackdrop = document.getElementById("mobile-menu-backdrop");
  const mobileLinks = document.querySelectorAll(".mobile-nav-link");
  let menuOpen = false;

  function handleScroll() {
    if (!navbar) return;
    if (window.scrollY > 80) {
      navbar.classList.add("nav-scrolled");
    } else {
      navbar.classList.remove("nav-scrolled");
    }
  }

  window.addEventListener("scroll", handleScroll, { passive: true });
  handleScroll();

  function openMenu() {
    menuOpen = true;
    mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
    document.body.style.overflow = "hidden";
    // Animate burger to X
    const lines = mobileBtn?.querySelectorAll(".burger-line");
    if (lines && lines.length === 3) {
      (lines[0] as HTMLElement).style.transform = "translateY(7px) rotate(45deg)";
      (lines[0] as HTMLElement).style.backgroundColor = "#F5B532";
      (lines[1] as HTMLElement).style.opacity = "0";
      (lines[2] as HTMLElement).style.transform = "translateY(-7px) rotate(-45deg)";
      (lines[2] as HTMLElement).style.backgroundColor = "#F5B532";
    }
  }

  function closeMenu() {
    menuOpen = false;
    mobileMenu?.classList.add("opacity-0", "pointer-events-none");
    document.body.style.overflow = "";
    // Reset burger
    const lines = mobileBtn?.querySelectorAll(".burger-line");
    if (lines && lines.length === 3) {
      (lines[0] as HTMLElement).style.transform = "none";
      (lines[0] as HTMLElement).style.backgroundColor = "";
      (lines[1] as HTMLElement).style.opacity = "1";
      (lines[2] as HTMLElement).style.transform = "none";
      (lines[2] as HTMLElement).style.backgroundColor = "";
    }
  }

  mobileBtn?.addEventListener("click", () => {
    menuOpen ? closeMenu() : openMenu();
  });

  mobileClose?.addEventListener("click", closeMenu);
  mobileBackdrop?.addEventListener("click", closeMenu);
  mobileLinks.forEach((link) => {
    link.addEventListener("click", (e) => {
      const href = link.getAttribute("href") || "";
      // Check if it's an anchor on the current page (e.g. /#about on homepage, or #about)
      const isHomepage = window.location.pathname === "/";
      const anchorMatch = href.match(/^\/?#(.+)$/);
      if (anchorMatch && isHomepage) {
        e.preventDefault();
        closeMenu();
        requestAnimationFrame(() => {
          const target = document.getElementById(anchorMatch[1]);
          if (target) {
            target.scrollIntoView({ behavior: "smooth" });
          }
        });
      } else {
        closeMenu();
      }
    });
  });

  // Close on Escape
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menuOpen) closeMenu();
  });

  // Close on resize to desktop
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024 && menuOpen) closeMenu();
  });
</script>

<style>
  #navbar.nav-scrolled {
    @apply bg-charcoal/95 backdrop-blur-md;
  }

  #navbar.nav-scrolled .nav-link {
    @apply text-cream/70;
  }

  #navbar.nav-scrolled .nav-link:hover {
    @apply text-saffron;
  }

  #navbar.nav-scrolled .nav-logo {
    filter: brightness(1.1);
  }

  #navbar.nav-scrolled .burger-line {
    @apply bg-cream;
  }
</style>
